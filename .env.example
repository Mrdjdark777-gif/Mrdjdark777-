# Copy to .env on the server and set your own secrets. Do not commit .env.
ADMIN_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=./data/truethrills.db
STORAGE_DIR=./data/storage
PORT=3000
NODE_ENV=production
# Set after buying the domain and enabling HTTPS.
PUBLIC_SITE_URL=
# Absolute path to a Firebase service account JSON (Project settings ->
# Service accounts -> Generate new private key). Only needed to send native
# push notifications to the Android app; Web Push for browsers works without it.
FIREBASE_SERVICE_ACCOUNT_FILE=
