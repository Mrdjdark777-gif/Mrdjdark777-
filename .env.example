# Copy to .env on the server and set your own secrets. Do not commit .env.
ADMIN_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=./data/truethrills.db
STORAGE_DIR=./data/storage
PORT=3000
NODE_ENV=production
# Set after buying the domain and enabling HTTPS.
PUBLIC_SITE_URL=
# Absolute path to a Firebase service account JSON (Project settings ->
# Service accounts -> Generate new private key). Only needed to send native
# push notifications to the Android app; Web Push for browsers works without it.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Enable only behind nginx that overwrites X-Real-IP; keep Next bound to 127.0.0.1.
# Also required to rate-limit notification sign-ups per address: without a
# trusted address there is nobody to count, and a shared bucket would lock
# everyone out at once.
TRUST_PROXY=false
# How many devices may receive notifications. This is devices, not people: one
# listener with a phone and a browser is two. Raising it is not free — every
# device is one HTTPS request, and the "broadcast started" notice expires after
# 120 seconds, so whatever the queue has not sent by then is never delivered.
# Default 1000.
PUSH_DEVICE_LIMIT=1000
# Optional coturn on the existing VPS; leave blank until configured.
TURN_URLS=
TURN_SECRET=

# Live audio is delivered and archived by scripts/live-worker.mjs (ffmpeg required).
LIVE_DIR=./data/live
LIVE_ENABLED=false
# Optional private webhook receiving {checkedAt,ok,issues}; never a public channel.
MONITOR_WEBHOOK_URL=
